        mousemoverel(deltaX, deltaY)
    end
end)

Players.PlayerAdded:Connect(function(plr)
    plr.CharacterAdded:Connect(function() task.wait(0.1); RefreshESP(); UpdateWhitelistUI() end)
    plr:GetPropertyChangedSignal("Team"):Connect(function() RefreshESP(); UpdateWhitelistUI() end)
end)

Players.PlayerRemoving:Connect(function(plr)
    if Target and Target == plr.Character then Target = nil end
    local idx = table.find(Settings.UserWhitelist, plr.Name)
    if idx then table.remove(Settings.UserWhitelist, idx) end
    destroyHighlightForModel(plr.Character)
    RefreshESP()
    UpdateWhitelistUI()
end)

LocalPlayer:GetPropertyChangedSignal("Team"):Connect(RefreshESP)
ClearAllESP()
