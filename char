----------------------------------------------------
-- SEÇÃO DE EXECUÇÃO E RESTAURAÇÃO
----------------------------------------------------
local SecApply = PageEdit:addSection("Executar & Restaurar")

-- BOTÃO APLICAR
SecApply:addButton("APLICAR TODAS AS MUDANÇAS", function()
    local targetName = inputTargetNick ~= "" and inputTargetNick or LocalPlayer.Name
    local targetChar = workspace:FindFirstChild(targetName)
    
    if not targetChar or not targetChar:FindFirstChild("Head") then
        UI:Notify("Erro!", "Jogador '" .. targetName .. "' não encontrado!")
        return
    end

    local head = targetChar.Head
    local labelNome = head:FindFirstChild("Nome", true) and head:FindFirstChild("Nome", true):FindFirstChildOfClass("TextLabel")
    local labelPatente = head:FindFirstChild("Patente", true) and head:FindFirstChild("Patente", true):FindFirstChildOfClass("TextLabel")
    local labelDivisao = (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)) 
                         and (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)):FindFirstChildOfClass("TextLabel")

    local shirt = targetChar:FindFirstChildOfClass("Shirt")
    local pants = targetChar:FindFirstChildOfClass("Pants")

    -- Fazer Backup do estado original
    if not backups[targetName] then
        backups[targetName] = {
            ShirtTemplate = shirt and shirt.ShirtTemplate or nil,
            PantsTemplate = pants and pants.PantsTemplate or nil,
            NomeText = labelNome and labelNome.Text or nil,
            NomeColor = labelNome and labelNome.TextColor3 or nil,
            PatenteText = labelPatente and labelPatente.Text or nil,
            PatenteColor = labelPatente and labelPatente.TextColor3 or nil,
            DivisaoText = labelDivisao and labelDivisao.Text or nil,
            DivisaoColor = labelDivisao and labelDivisao.TextColor3 or nil,
        }
    end

    -- 1. APLICAÇÃO DA FARDA
    if fardaUsar and fardaSelecionada ~= "Nenhuma" and Fardas[fardaSelecionada] then
        local config = Fardas[fardaSelecionada]
        shirt = shirt or Instance.new("Shirt", targetChar)
        pants = pants or Instance.new("Pants", targetChar)
        shirt.ShirtTemplate = config.S
        pants.PantsTemplate = config.P
    end

    -- 2. EDITA AS TAGS OVERHEAD
    local customNick = inputDisplayNick ~= "" and inputDisplayNick or targetName

    local formattedName = ""
    if usarTag then
        formattedName = string.format("[%s] %s • %s", cargoStatus, deviceIcon, customNick)
    else
        formattedName = string.format("%s • %s", deviceIcon, customNick)
    end

    if labelNome then
        labelNome.Text = formattedName
        labelNome.TextColor3 = selectedColor
    end

    if labelPatente then
        labelPatente.Text = inputPatente
        labelPatente.TextColor3 = selectedColor
    end

    if labelDivisao then
        labelDivisao.Text = inputDivisao
        labelDivisao.TextColor3 = selectedColor
    end

    UI:Notify("Sucesso!", "Propriedades aplicadas em: " .. targetName)
end)

-- BOTÃO RESTAURAR PADRÃO
SecApply:addButton("RESTAURAR PADRÃO", function()
    local targetName = inputTargetNick ~= "" and inputTargetNick or LocalPlayer.Name
    local targetChar = workspace:FindFirstChild(targetName)

    if not targetChar or not targetChar:FindFirstChild("Head") then
        UI:Notify("Erro!", "Jogador '" .. targetName .. "' não encontrado!")
        return
    end

    local backup = backups[targetName]

    if not backup then
        UI:Notify("Aviso", "Nenhum histórico encontrado para: " .. targetName)
        return
    end

    -- Restaura Farda
    local shirt = targetChar:FindFirstChildOfClass("Shirt")
    local pants = targetChar:FindFirstChildOfClass("Pants")

    if shirt then
        if backup.ShirtTemplate then
            shirt.ShirtTemplate = backup.ShirtTemplate
        else
            shirt:Destroy()
        end
    end

    if pants then
        if backup.PantsTemplate then
            pants.PantsTemplate = backup.PantsTemplate
        else
            pants:Destroy()
        end
    end

    -- Restaura Overhead
    local head = targetChar.Head
    local labelNome = head:FindFirstChild("Nome", true) and head:FindFirstChild("Nome", true):FindFirstChildOfClass("TextLabel")
    local labelPatente = head:FindFirstChild("Patente", true) and head:FindFirstChild("Patente", true):FindFirstChildOfClass("TextLabel")
    local labelDivisao = (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)) 
                         and (head:FindFirstChild("Divis\195\163o", true) or head:FindFirstChild("Divisão", true)):FindFirstChildOfClass("TextLabel")

    if labelNome and backup.NomeText then
        labelNome.Text = backup.NomeText
        labelNome.TextColor3 = backup.NomeColor
    end

    if labelPatente and backup.PatenteText then
        labelPatente.Text = backup.PatenteText
        labelPatente.TextColor3 = backup.PatenteColor
    end

    if labelDivisao and backup.DivisaoText then
        labelDivisao.Text = backup.DivisaoText
        labelDivisao.TextColor3 = backup.DivisaoColor
    end

    UI:Notify("Restaurado!", "Aparência original de " .. targetName .. " restaurada.")
end)

----------------------------------------------------
-- NOVA SEÇÃO: MOORPH / COPIAR APARÊNCIA (CHAR)
----------------------------------------------------
local SecMorph = PageEdit:addSection("Copiar Aparência (Char)")

SecMorph:addTextbox("Nick do Player (Roblox)", "Ex: Roblox", function(value)
    inputCharTarget = value
end)

SecMorph:addButton("COPIAR SKIN (VISUAL)", function()
    if inputCharTarget == "" then
        UI:Notify("Aviso", "Digite o nome exato de um jogador do Roblox!")
        return
    end

    UI:Notify("Aguarde", "Buscando visual de: " .. inputCharTarget)

    task.spawn(function()
        local success, targetUserId = pcall(function()
            return Players:GetUserIdFromNameAsync(inputCharTarget)
        end)

        if not success or not targetUserId then
            UI:Notify("Erro!", "Não foi possível encontrar o UserId para: " .. inputCharTarget)
            return
        end

        local myChar = LocalPlayer.Character
        if not myChar or not myChar:FindFirstChild("Humanoid") then
            UI:Notify("Erro!", "Seu personagem não está carregado!")
            return
        end

        local humanoid = myChar:FindFirstChildOfClass("Humanoid")

        -- Aplica a descrição do avatar via HumanoidDescription
        local descSuccess, humDesc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(targetUserId)
        end)

        if descSuccess and humDesc then
            pcall(function()
                humanoid:ApplyDescription(humDesc)
            end)
            UI:Notify("Sucesso!", "Sua skin foi alterada para: " .. inputCharTarget)
        else
            UI:Notify("Erro!", "Falha ao carregar roupas/acessórios do avatar.")
        end
    end)
end)

-- Atalho para ocultar UI (Left Control)
UI:bindToKey(Enum.KeyCode.LeftControl)

-- Seleciona a página principal
UI:SelectPage(PageEdit, true)
