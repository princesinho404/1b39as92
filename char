-- 1. Carrega a Venyx UI
local Venyx = loadstring(game:HttpGet("https://raw.githubusercontent.com/GreenDeno/Venyx-UI-Library/main/source.lua"))()
local UI = Venyx.new("NOX SYSTEM - Editor de Player", 5013109572)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- 2. Tabela de Fardas
local Fardas = {
    ["Nenhuma"] = nil,
    ["Elite"] = {S = "rbxassetid://75117162625698", P = "rbxassetid://132857388083739"},
    ["Oficiais"] = {S = "rbxassetid://14825639654", P = "rbxassetid://14825643510"},
    ["Generais"] = {S = "rbxassetid://278436685", P = "rbxassetid://278437052"}
}

-- 3. Histórico de Backup para Restauração
local backups = {}

-- 4. Variáveis de Configuração
local inputTargetNick = ""
local inputDisplayNick = ""
local inputPatente = ""
local inputDivisao = "N/A"
local inputCharTarget = ""

local selectedColor = Color3.fromRGB(255, 255, 255)

local usarTag = true
local fardaUsar = false
local fardaSelecionada = "Nenhuma"

local cargoStatus = "ELITE"
local deviceIcon = "🖥️"

----------------------------------------------------
-- PÁGINA: EDITOR DE PLAYER
----------------------------------------------------
